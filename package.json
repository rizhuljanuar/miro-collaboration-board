{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:laravel": "php artisan serve",
    "dev:reverb": "php artisan reverb:start",
    "dev:all": "concurrently -k \"bun run dev\" \"bun run dev:laravel\" \"bun run dev:reverb\""
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write 'resources/js/**/*.{js,mjs,cjs,ts,jsx,tsx,vue,css}' && vendor/bin/pint"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.3.11"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "laravel-echo": "^2.5.0",
    "pinia": "^4.0.3",
    "pusher-js": "^8.6.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  }
}
